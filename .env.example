# ---------------------------------------------------------------------------
# Studioz D — frontend environment. Copy to `.env.local` and fill in.
# Every VITE_* value is PUBLIC (it ships inside the JS bundle).
# Never put a private API secret here.
# ---------------------------------------------------------------------------

# Canonical site origin, no trailing slash. Used for canonical URLs, OG tags
# and the generated sitemap.
VITE_SITE_URL=https://studiozd.in 

# --- Enquiries → Google Sheet + email -------------------------------------
# The Web app URL of docs/enquiry-apps-script.gs (ends in /exec). Set, every
# enquiry becomes a Sheet row and an email; WhatsApp opens after, either way.
VITE_ENQUIRY_SHEET_URL=https://script.google.com/macros/s/AKfycbw6DsHSl8XNmGy8BLxRal3MOGlFEsp6ydHhEEZ9xrfhYvxElCCJlmh9uVCUKbl7dE3PIg/exec

# --- EmailJS (optional — only used when VITE_ENQUIRY_SHEET_URL is blank) ----
# Create a service + template at https://dashboard.emailjs.com
# The public key is designed to be exposed client-side.
VITE_EMAILJS_SERVICE_ID=service_j7lpeqd
VITE_EMAILJS_TEMPLATE_ID=template_n4hiqhh
VITE_EMAILJS_PUBLIC_KEY=HdokEg1r7vHTDenIn

# --- Contact channels ------------------------------------------------------
# The studio's real details are the defaults in src/config/site.js. Set these
# only to override them. WhatsApp: international format, digits only.
VITE_WHATSAPP_NUMBER=7200096586
VITE_CONTACT_EMAIL=hellostudiozd@gmail.com
VITE_CONTACT_PHONE=9600096586

